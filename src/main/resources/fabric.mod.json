  "name": "GIF Screenshots",
  "description": "Record a short animated GIF screenshot with a keybind.",
  "authors": ["deanxbox"],
  "license": "MIT",
  "icon": "assets/gif-screenshots/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.dean.gifscreenshots.GifScreenshotsClient"],
    "modmenu": ["io.github.dean.gifscreenshots.ModMenuIntegration"]
